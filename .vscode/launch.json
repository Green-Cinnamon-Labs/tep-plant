{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "tep-plant (com adaptador OPC-UA)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=tep-plant", "--features=opcua"]
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Planta: 1x (tempo real, 3.6 s/step)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/tennessee-eastman-service/target/debug/te_service.exe",
      "args": ["--headless"],
      "cwd": "${workspaceFolder}/tennessee-eastman-service",
      "preLaunchTask": "cargo build",
      "sourceLanguages": ["rust"],
            "env": {
        "STEP_DELAY_MS": "3600",
        "ACTIVE_IDV": ""
      }
    },
    {
      "name": "Planta: baseline (100x, sem distúrbios)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/tennessee-eastman-service/target/debug/te_service.exe",
      "args": ["--headless"],
      "cwd": "${workspaceFolder}/tennessee-eastman-service",
      "preLaunchTask": "cargo build",
      "sourceLanguages": ["rust"],
            "env": {
        "STEP_DELAY_MS": "36",
        "ACTIVE_IDV": ""
      }
    },
    {
      "name": "Planta: velocidade máxima (sem delay)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/tennessee-eastman-service/target/debug/te_service.exe",
      "args": ["--headless"],
      "cwd": "${workspaceFolder}/tennessee-eastman-service",
      "preLaunchTask": "cargo build",
      "sourceLanguages": ["rust"],
            "env": {
        "STEP_DELAY_MS": "0",
        "ACTIVE_IDV": ""
      }
    }
  ]
}
