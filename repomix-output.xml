    writeln!(w, "description = \"TEP snapshot at t = {:.4} h\"", t_h).unwrap();
    writeln!(w, "source = \"auto-snapshot from simulation\"").unwrap();
    writeln!(w).unwrap();

    writeln!(w, "[state.reactor_vapor]").unwrap();
    for (i, c) in comps.iter().enumerate() {
