      DO 100 I = 1, 20
          IDV(I) = 0
 100  CONTINUE
C      IDV(20)=1	
C
C
C
C
	OPEN(UNIT=111,FILE='~/TE_data_inc.dat',STATUS='new')
	OPEN(UNIT=1111,FILE='~/TE_data_mv1.dat',STATUS='new')
	OPEN(UNIT=1112,FILE='~/TE_data_mv2.dat',STATUS='new')
