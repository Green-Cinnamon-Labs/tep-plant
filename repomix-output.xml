<file path="tennessee-eastman-service/service/proto/tep/v1/plant.proto">
syntax = "proto3";
package tep.v1;

// ─── Serviço principal ─────────────────────────────────────────────────────────
// A planta expõe apenas RPCs de LEITURA + ajuste de parâmetros.
// Não permite criar/remover controladores nem controlar distúrbios.
// Controladores são definidos no código Rust (main.rs).
// Distúrbios são aleatórios — o operator reage aos efeitos, não causa.

service PlantService {
  // Observação: stream contínuo de métricas da planta
  rpc StreamMetrics(StreamMetricsRequest) returns (stream PlantMetrics);

  // Leitura: snapshot pontual do estado
  rpc GetPlantStatus(GetPlantStatusRequest) returns (PlantStatus);

  // Leitura: lista controladores ativos
  rpc ListControllers(ListControllersRequest) returns (ListControllersResponse);

  // Escrita: atualiza parâmetros de um controlador existente
  rpc UpdateController(UpdateControllerRequest) returns (UpdateControllerResponse);

  // Escrita: ativa/desativa distúrbios em tempo real (sem reiniciar)
  rpc UpdateDisturbances(UpdateDisturbancesRequest) returns (UpdateDisturbancesResponse);

  // Escrita: controla simulação (pause, resume, reset)
  rpc ControlSimulation(ControlSimulationRequest) returns (ControlSimulationResponse);

  // Escrita: ajusta velocidade de simulação (0.0 = max, 1.0 = real-time, 2.0 = 2× real-time)
  rpc SetSpeed(SetSpeedRequest) returns (SetSpeedResponse);
}

// ─── Métricas e status ─────────────────────────────────────────────────────────

message StreamMetricsRequest {
  double interval_ms = 1;  // intervalo mínimo entre mensagens (0 = cada tick)
}

message PlantMetrics {
  double t_h = 1;
  repeated double xmeas = 2;       // 22 medições contínuas
  repeated double xmv = 3;         // 12 variáveis manipuladas
  repeated Alarm alarms = 4;
  double deriv_norm = 5;
  bool isd_active = 6;
}

message Alarm {
  string variable = 1;
  string condition = 2;
  bool active = 3;
}

message GetPlantStatusRequest {}

message PlantStatus {
  PlantMetrics metrics = 1;
  repeated ControllerInfo controllers = 2;
  repeated uint32 active_idv = 3;
}

// ─── Controladores ─────────────────────────────────────────────────────────────

message ControllerInfo {
  string id = 1;
  string controller_type = 2;      // "P", "PI", "PID"
  uint32 xmeas_index = 3;
  uint32 xmv_index = 4;
  double kp = 5;
  double ki = 6;
  double kd = 7;
  double setpoint = 8;
  double bias = 9;
  bool enabled = 10;
  // Observados (preenchidos pelo servidor)
  double current_measurement = 11;
  double current_output = 12;
  double error = 13;
}

message ListControllersRequest {}

message ListControllersResponse {
  repeated ControllerInfo controllers = 1;
}

message UpdateControllerRequest {
  string id = 1;
  optional double kp = 2;
  optional double ki = 3;
  optional double kd = 4;
  optional double setpoint = 5;
  optional double bias = 6;
  optional bool enabled = 7;
}

message UpdateControllerResponse {
  bool success = 1;
  string message = 2;
  ControllerInfo controller = 3;
}

// ─── Disturbance Control ───────────────────────────────────────────────────────

message UpdateDisturbancesRequest {
  repeated uint32 active_idv = 1;                // Lista de IDVs a ativar (1-20)
  map<uint32, float> idv_magnitudes = 2;         // Magnitude por IDV (ex: {4: 10.0} para +10°C)
}

message UpdateDisturbancesResponse {
  bool success = 1;
  string message = 2;
  repeated uint32 active_idv = 3;  // Estado resultante
}

// ─── Simulation Control ───────────────────────────────────────────────────────

message ControlSimulationRequest {
  enum Action {
    PAUSE = 0;
    RESUME = 1;
    RESET = 2;  // Reset ao snapshot inicial, sem sair do loop
  }
  Action action = 1;
}

message ControlSimulationResponse {
  bool success = 1;
  string message = 2;
  bool paused = 3;  // Estado atual da simulação
}

// ─── Speed Control ────────────────────────────────────────────────────────────

message SetSpeedRequest {
  float factor = 1;  // 0.0 = max speed, 1.0 = real-time, N = N× real-time
}

message SetSpeedResponse {
  bool success = 1;
  float factor = 2;  // Factor efetivo aplicado
}
</file>

