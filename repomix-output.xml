C ============================================================
C Tennessee Eastman Process Control Test Problem
C ============================================================
C
C Authors:
C   James J. Downs
C   Ernest F. Vogel
C
C Organization:
C   Process and Control Systems Engineering
C   Tennessee Eastman Company
C   P.O. Box 511
C   Kingsport, TN 37662
C
C ------------------------------------------------------------
C Reference:
C   "A Plant-Wide Industrial Process Control Problem"
C   AIChE 1990 Annual Meeting
C   Industrial Challenge Problems in Process Control
C   Paper #24a
C   Chicago, Illinois, November 14, 1990
C
C ------------------------------------------------------------
C Revision History:
C   04-04-1991
C   - Corrected documentation of manipulated variables
C
C ============================================================
C SUBROUTINES PROVIDED
C ============================================================
C
C   TEFUNC  - Function evaluator (process model / dynamics)
C   TEINIT  - Initialization routine
C   TESUBi  - Utility subroutines, i = 1,2,...,8
C
C ============================================================
C MODEL SIZE AND EXTENSIBILITY
C ============================================================
C
C   The process simulation has 50 states (NN = 50).
C
C   If additional states are required:
C     - Increase NN in the calling program
C     - Append new states to the YY vector:
C         YY(51), YY(52), ..., YY(NN)
C     - Append corresponding derivatives to YP:
C         YP(51), YP(52), ..., YP(NN)
C
C ============================================================
C GUIDELINES FOR EXTENDING THE MODEL
C ============================================================
C
C Example: extending the function evaluator
C
C   SUBROUTINE FUNC(NN, TIME, YY, YP)
C     INTEGER NN
C     DOUBLE PRECISION TIME, YY(NN), YP(NN)
C
C     CALL TEFUNC(NN, TIME, YY, YP)
C
C     YP(51) = ...
C     YP(52) = ...
C        .
C        .
C     YP(NN) = ...
C
C     RETURN
C   END
C
C ------------------------------------------------------------
C
C Example: extending the initialization routine
C
C   SUBROUTINE INIT(NN, TIME, YY, YP)
C     INTEGER NN
C     DOUBLE PRECISION TIME, YY(NN), YP(NN)
C
C     CALL TEINIT(NN, TIME, YY, YP)
C
C     YY(51) = ...
C     YY(52) = ...
C        .
C        .
C     YY(NN) = ...
C
C     RETURN
C   END
C
C ============================================================
C DIFFERENCES BETWEEN CODE AND PUBLISHED PAPER
C ============================================================
C
C 1) TEINIT includes TIME in the argument list and sets TIME = 0
C
C 2) There are 8 utility subroutines (TESUBi), not 5
C
C 3) Disturbances IDV(14) through IDV(20) do NOT require coupling
C    with other disturbances; all disturbances may be used
C    independently or in any combination
C
C ============================================================
C MANIPULATED VARIABLES (XMV)
C ============================================================
C
C   XMV(1)   D Feed Flow (Stream 2)               [Corrected Order]
C   XMV(2)   E Feed Flow (Stream 3)               [Corrected Order]
C   XMV(3)   A Feed Flow (Stream 1)               [Corrected Order]
C   XMV(4)   A and C Feed Flow (Stream 4)
C   XMV(5)   Compressor Recycle Valve
C   XMV(6)   Purge Valve (Stream 9)
C   XMV(7)   Separator Pot Liquid Flow (Stream 10)
C   XMV(8)   Stripper Liquid Product Flow (Stream 11)
C   XMV(9)   Stripper Steam Valve
C   XMV(10)  Reactor Cooling Water Flow
C   XMV(11)  Condenser Cooling Water Flow
C   XMV(12)  Agitator Speed
C
C ============================================================
C CONTINUOUS PROCESS MEASUREMENTS (XMEAS 1–22)
C ============================================================
C
C   XMEAS(1)   A Feed (Stream 1)                   kscmh
C   XMEAS(2)   D Feed (Stream 2)                   kg/hr
C   XMEAS(3)   E Feed (Stream 3)                   kg/hr
C   XMEAS(4)   A and C Feed (Stream 4)             kscmh
C   XMEAS(5)   Recycle Flow (Stream 8)             kscmh
C   XMEAS(6)   Reactor Feed Rate (Stream 6)        kscmh
C   XMEAS(7)   Reactor Pressure                    kPa (gauge)
C   XMEAS(8)   Reactor Level                       %
C   XMEAS(9)   Reactor Temperature                 °C
C   XMEAS(10)  Purge Rate (Stream 9)               kscmh
C   XMEAS(11)  Product Separator Temperature       °C
C   XMEAS(12)  Product Separator Level             %
C   XMEAS(13)  Product Separator Pressure          kPa (gauge)
C   XMEAS(14)  Separator Underflow (Stream 10)     m³/hr
C   XMEAS(15)  Stripper Level                      %
C   XMEAS(16)  Stripper Pressure                   kPa (gauge)
C   XMEAS(17)  Stripper Underflow (Stream 11)      m³/hr
C   XMEAS(18)  Stripper Temperature                °C
C   XMEAS(19)  Stripper Steam Flow                 kg/hr
C   XMEAS(20)  Compressor Work                     kW
C   XMEAS(21)  Reactor Cooling Water Outlet Temp   °C
C   XMEAS(22)  Separator Cooling Water Outlet Temp °C
C
C ============================================================
C SAMPLED PROCESS MEASUREMENTS (XMEAS 23–41)
C ============================================================
C
C Reactor Feed Analysis (Stream 6)
C   Sampling Period = 0.1 hr
C   Dead Time       = 0.1 hr
C   Units           = Mole %
C
C   XMEAS(23)  Component A
C   XMEAS(24)  Component B
C   XMEAS(25)  Component C
C   XMEAS(26)  Component D
C   XMEAS(27)  Component E
C   XMEAS(28)  Component F
C
C ------------------------------------------------------------
C Purge Gas Analysis (Stream 9)
C   Sampling Period = 0.1 hr
C   Dead Time       = 0.1 hr
C   Units           = Mole %
C
C   XMEAS(29)  Component A
C   XMEAS(30)  Component B
C   XMEAS(31)  Component C
C   XMEAS(32)  Component D
C   XMEAS(33)  Component E
C   XMEAS(34)  Component F
C   XMEAS(35)  Component G
C   XMEAS(36)  Component H
C
C ------------------------------------------------------------
C Product Analysis (Stream 11)
C   Sampling Period = 0.25 hr
C   Dead Time       = 0.25 hr
C   Units           = Mole %
C
C   XMEAS(37)  Component D
C   XMEAS(38)  Component E
C   XMEAS(39)  Component F
C   XMEAS(40)  Component G
C   XMEAS(41)  Component H
C
C ============================================================
C PROCESS DISTURBANCES (IDV)
C ============================================================
C
C   IDV(1)   A/C Feed Ratio, B Constant (Stream 4)        Step
C   IDV(2)   B Composition, A/C Constant (Stream 4)      Step
C   IDV(3)   D Feed Temperature (Stream 2)               Step
C   IDV(4)   Reactor Cooling Water Inlet Temperature     Step
C   IDV(5)   Condenser Cooling Water Inlet Temperature   Step
C   IDV(6)   A Feed Loss (Stream 1)                      Step
C   IDV(7)   C Header Pressure Loss (Stream 4)           Step
C
C   IDV(8)   A,B,C Feed Composition (Stream 4)           Random
C   IDV(9)   D Feed Temperature (Stream 2)               Random
C   IDV(10)  C Feed Temperature (Stream 4)               Random
C   IDV(11)  Reactor Cooling Water Inlet Temperature     Random
C   IDV(12)  Condenser Cooling Water Inlet Temperature   Random
C
C   IDV(13)  Reaction Kinetics                            Slow Drift
C   IDV(14)  Reactor Cooling Water Valve                  Sticking
C   IDV(15)  Condenser Cooling Water Valve                Sticking
C   IDV(16)  Unknown
C   IDV(17)  Unknown
C   IDV(18)  Unknown
C   IDV(19)  Unknown
C   IDV(20)  Unknown

C ============================================================
C TEFUNC
C Avaliador da função dinâmica do Tennessee Eastman Process
C Calcula: YP = d(YY)/dt no instante TIME
C ------------------------------------------------------------
C Entradas:
C   NN   = número de equações diferenciais
C   TIME = tempo atual (horas)
C   YY   = vetor de estados atuais
C
C Saídas:
C   YP   = vetor das derivadas dos estados
C ============================================================

      SUBROUTINE TEFUNC(NN,TIME,YY,YP)

C ---
C 1) INTERFACE PADRÃO DO BENCHMARK (PLANTA ↔ EXTERNO)
C ---

      DOUBLE PRECISION XMEAS,XMV
      COMMON /PV/ XMEAS(41),XMV(12)

      INTEGER IDV
      COMMON /DVEC/ IDV(20)

C ---
C 2) DECLARAÇÃO DE VARIÁVEIS AUXILIARES (SEM DIMENSÃO)
C ---

      DOUBLE PRECISION
     .UCLR,UCVR,UTLR,UTVR,
     .XLR,XVR,ETR,ESR,
     .TCR,TKR,DLR,
     .VLR,VVR,VTR,
     .PTR,PPR,
     .CRXR,RR,RH,
     .FWR,TWR,QUR,HWR,UAR,
     .UCLS,UCVS,UTLS,UTVS,
     .XLS,XVS,ETS,ESS,
     .TCS,TKS,DLS,
     .VLS,VVS,VTS,
     .PTS,PPS,
     .FWS,TWS,QUS,HWS,
     .UCLC,UTLC,XLC,
     .ETC,ESC,TCC,DLC,
     .VLC,VTC,QUC,
     .UCVV,UTVV,XVV,
     .ETV,ESV,TCV,TKV,
     .VTV,PTV,
     .VCV,VRNG,VTAU,
     .FTM,
     .FCM,XST,XMWS,
     .HST,TST,SFR,
     .CPFLMX,CPPRMX,CPDH,
     .TCWR,TCWS,
     .HTR,AGSP,
     .XDEL,XNS,
     .TGAS,TPROD,VST

      INTEGER
     .IVST

C ---
C 3) MEMÓRIA GLOBAL DO PROCESSO (ESTADOS AUXILIARES)
C ---

      COMMON /TEPROC/
     .UCLR(8),UCVR(8),UTLR,UTVR,
     .XLR(8),XVR(8),ETR,ESR,
     .TCR,TKR,DLR,
     .VLR,VVR,VTR,
     .PTR,PPR(8),
     .CRXR(8),RR(4),RH,
     .FWR,TWR,QUR,HWR,UAR,
     .UCLS(8),UCVS(8),UTLS,UTVS,
     .XLS(8),XVS(8),ETS,ESS,
     .TCS,TKS,DLS,
     .VLS,VVS,VTS,
     .PTS,PPS(8),
     .FWS,TWS,QUS,HWS,
     .UCLC(8),UTLC,XLC(8),
     .ETC,ESC,TCC,DLC,
     .VLC,VTC,QUC,
     .UCVV(8),UTVV,XVV(8),
     .ETV,ESV,TCV,TKV,
     .VTV,PTV,
     .VCV(12),VRNG(12),VTAU(12),
     .FTM(13),
     .FCM(8,13),XST(8,13),XMWS(13),
     .HST(13),TST(13),SFR(8),
     .CPFLMX,CPPRMX,CPDH,
     .TCWR,TCWS,
     .HTR(3),AGSP,
     .XDEL(41),XNS(41),
     .TGAS,TPROD,VST(12),IVST(12)

C ---
C 4) BLOCO DE DISTÚRBIOS TEMPORAIS (WALKING DISTURBANCES)
C ---

      INTEGER IDVWLK
      DOUBLE PRECISION
     .ADIST,BDIST,CDIST,DDIST,
     .TLAST,TNEXT,
     .HSPAN,HZERO,
     .SSPAN,SZERO,
     .SPSPAN

      COMMON /WLK/
     .ADIST(12),
     .BDIST(12),
     .CDIST(12),
     .DDIST(12),
     .TLAST(12),
     .TNEXT(12),
     .HSPAN(12),
     .HZERO(12),
     .SSPAN(12),
     .SZERO(12),
     .SPSPAN(12),
     .IDVWLK(12)

C ---
C 5) CONSTANTES FÍSICO-QUÍMICAS
C ---

      DOUBLE PRECISION
     .AVP,BVP,CVP,
     .AH,BH,CH,
     .AG,BG,CG,
     .AV,
     .AD,BD,CD,
     .XMW

      COMMON /CONST/
     .AVP(8),BVP(8),CVP(8),
     .AH(8),BH(8),CH(8),
     .AG(8),BG(8),CG(8),
     .AV(8),
     .AD(8),BD(8),CD(8),
     .XMW(8)


C ---
C 6) VARIÁVEIS LOCAIS DA DINÂMICA
C ---

      INTEGER NN,I,ISD
      DOUBLE PRECISION RG,
     .VPR,
     .FIN(8),
     .YY(NN),
     .YP(NN),
     .TIME,
     .FLMS,
     .DLP,
     .PR,
     .FLCOEF,
     .UAS,
     .UAC,
     .VOVRL,
     .UARLEV,
     .VPOS(12),
     .XMNS,
     .XCMP(41),
     .TMPFAC,
     .R1F,
     .R2F,
     .HWLK,
     .SWLK,
     .SPWLK,
     .TESUB7,
     .TESUB8


C ---
C 7) NORMALIZAÇÃO DOS FLAGS DE DISTÚRBIO
C ---

      DO 500 I=1,20
         IF(IDV(I).GT.0)THEN
            IDV(I)=1
         ELSE
            IDV(I)=0
         ENDIF
 500  CONTINUE

C ---
C 8) MAPEAMENTO DOS DISTÚRBIOS PARA PERFIS TEMPORAIS
C ---

      IDVWLK(1)=IDV(8)
      IDVWLK(2)=IDV(8)
      IDVWLK(3)=IDV(9)
      IDVWLK(4)=IDV(10)
      IDVWLK(5)=IDV(11)
      IDVWLK(6)=IDV(12)
      IDVWLK(7)=IDV(13)
      IDVWLK(8)=IDV(13)
      IDVWLK(9)=IDV(16)
      IDVWLK(10)=IDV(17)
      IDVWLK(11)=IDV(18)
      IDVWLK(12)=IDV(20)

C ---
C 9) ATUALIZAÇÃO DOS PERFIS DE DISTÚRBIO NO TEMPO
C ---
      DO 900 I=1,9
      IF(TIME.GE.TNEXT(I))THEN
      HWLK=TNEXT(I)-TLAST(I)
      SWLK=ADIST(I)+HWLK*(BDIST(I)+HWLK*
     .(CDIST(I)+HWLK*DDIST(I)))
      SPWLK=BDIST(I)+HWLK*
     .(2.D0*CDIST(I)+3.D0*HWLK*DDIST(I))
      TLAST(I)=TNEXT(I)
      CALL TESUB5(SWLK,SPWLK,ADIST(I),BDIST(I),CDIST(I),
     .DDIST(I),TLAST(I),TNEXT(I),HSPAN(I),HZERO(I),
     .SSPAN(I),SZERO(I),SPSPAN(I),IDVWLK(I))
      ENDIF
  900 CONTINUE

C ---
C 10) DISTÚRBIOS COM COMPORTAMENTO ESPECIAL
C ---

      DO 910 I=10,12
      IF(TIME.GE.TNEXT(I))THEN
      HWLK=TNEXT(I)-TLAST(I)
      SWLK=ADIST(I)+HWLK*(BDIST(I)+HWLK*
     .(CDIST(I)+HWLK*DDIST(I)))
      SPWLK=BDIST(I)+HWLK*
     .(2.D0*CDIST(I)+3.D0*HWLK*DDIST(I))
      TLAST(I)=TNEXT(I)
      IF(SWLK.GT.0.1D0)THEN
      ADIST(I)=SWLK
      BDIST(I)=SPWLK
      CDIST(I)=-(3.D0*SWLK+0.2D0*SPWLK)/0.01D0
      DDIST(I)=(2.D0*SWLK+0.1D0*SPWLK)/0.001D0
      TNEXT(I)=TLAST(I)+0.1D0
      ELSE
      ISD=-1
      HWLK=HSPAN(I)*TESUB7(ISD)+HZERO(I)
      ADIST(I)=0.D0
      BDIST(I)=0.D0
      CDIST(I)=DBLE(IDVWLK(I))/HWLK**2
      DDIST(I)=0.D0
      TNEXT(I)=TLAST(I)+HWLK
      ENDIF
      ENDIF
  910 CONTINUE

C ---
C 11) INICIALIZAÇÃO DOS DISTÚRBIOS NO TEMPO ZERO (estado inicial dos perfis temporais)
C ---

      IF (TIME .EQ. 0.D0) THEN
         DO 950 I = 1,12
            ADIST(I) = SZERO(I)
            BDIST(I) = 0.D0
            CDIST(I) = 0.D0
            DDIST(I) = 0.D0
            TLAST(I) = 0.0D0
            TNEXT(I) = 0.1D0
  950    CONTINUE
      END IF


C ---
C 12) ATUALIZAÇÃO DE FEEDS E TEMPERATURAS DE ENTRADA (condições externas dependentes do tempo + distúrbios)
C ---

      XST(1,4) = TESUB8(1,TIME)
     .          - IDV(1)*0.03D0
     .          - IDV(2)*2.43719D-3

      XST(2,4) = TESUB8(2,TIME)
     .          + IDV(2)*0.005D0

      XST(3,4) = 1.D0 - XST(1,4) - XST(2,4)

      TST(1)   = TESUB8(3,TIME) + IDV(3)*5.D0
      TST(4)   = TESUB8(4,TIME)

      TCWR     = TESUB8(5,TIME) + IDV(4)*5.D0
      TCWS     = TESUB8(6,TIME) + IDV(5)*5.D0

      R1F      = TESUB8(7,TIME)
      R2F      = TESUB8(8,TIME)


C ---
C 13) EXTRAÇÃO DO VETOR DE ESTADOS YY → VARIÁVEIS DE PROCESSO
C ---

C --- Vazões molares por componente (reator / separador)

      DO 1010 I = 1,3
         UCVR(I) = YY(I)
         UCVS(I) = YY(I+9)
         UCLR(I) = 0.0
         UCLS(I) = 0.0
 1010 CONTINUE

      DO 1020 I = 4,8
         UCLR(I) = YY(I)
         UCLS(I) = YY(I+9)
 1020 CONTINUE

      DO 1030 I = 1,8
         UCLC(I) = YY(I+18)
         UCVV(I) = YY(I+27)
 1030 CONTINUE

C --- Estados energéticos e térmicos

      ETR = YY(9)
      ETS = YY(18)
      ETC = YY(27)
      ETV = YY(36)

      TWR = YY(37)
      TWS = YY(38)

C --- Posições de válvulas (últimos 12 estados)

      DO 1035 I = 1,12
         VPOS(I) = YY(I+38)
 1035 CONTINUE


C ---
C 14) TOTAIS DE MASSA E FRAÇÕES MOLARES
C ---

      UTLR = 0.0
      UTLS = 0.0
      UTLC = 0.0
      UTVV = 0.0

      DO 1040 I = 1,8
         UTLR = UTLR + UCLR(I)
         UTLS = UTLS + UCLS(I)
         UTLC = UTLC + UCLC(I)
         UTVV = UTVV + UCVV(I)
 1040 CONTINUE

      DO 1050 I = 1,8
         XLR(I) = UCLR(I)/UTLR
         XLS(I) = UCLS(I)/UTLS
         XLC(I) = UCLC(I)/UTLC
         XVV(I) = UCVV(I)/UTVV
 1050 CONTINUE


C ---
C 15) ENERGIA ESPECÍFICA E TEMPERATURAS
C ---

      ESR = ETR/UTLR
      ESS = ETS/UTLS
      ESC = ETC/UTLC
      ESV = ETV/UTVV

      CALL TESUB2(XLR,TCR,ESR,0)
      TKR = TCR + 273.15

      CALL TESUB2(XLS,TCS,ESS,0)
      TKS = TCS + 273.15

      CALL TESUB2(XLC,TCC,ESC,0)
      CALL TESUB2(XVV,TCV,ESV,2)
      TKV = TCV + 273.15


C ---
C 16) DENSIDADES, VOLUMES E PRESSÕES
C ---

      CALL TESUB4(XLR,TCR,DLR)
      CALL TESUB4(XLS,TCS,DLS)
      CALL TESUB4(XLC,TCC,DLC)

      VLR = UTLR/DLR
      VLS = UTLS/DLS
      VLC = UTLC/DLC

      VVR = VTR - VLR
      VVS = VTS - VLS

      RG  = 998.9
      PTR = 0.0
      PTS = 0.0

      DO 1110 I = 1,3
         PPR(I) = UCVR(I)*RG*TKR/VVR
         PTR    = PTR + PPR(I)

         PPS(I) = UCVS(I)*RG*TKS/VVS
         PTS    = PTS + PPS(I)
 1110 CONTINUE

      DO 1120 I = 4,8
         VPR    = DEXP(AVP(I)+BVP(I)/(TCR+CVP(I)))
         PPR(I) = VPR*XLR(I)
         PTR    = PTR + PPR(I)

         VPR    = DEXP(AVP(I)+BVP(I)/(TCS+CVP(I)))
         PPS(I) = VPR*XLS(I)
         PTS    = PTS + PPS(I)
 1120 CONTINUE

      PTV = UTVV*RG*TKV/VTV


C ---
C 17) CINÉTICA DAS REAÇÕES QUÍMICAS
C ---

      DO 1130 I = 1,8
         XVR(I) = PPR(I)/PTR
         XVS(I) = PPS(I)/PTS
 1130 CONTINUE

      UTVR = PTR*VVR/RG/TKR
      UTVS = PTS*VVS/RG/TKS

      DO 1140 I = 4,8
         UCVR(I) = UTVR*XVR(I)
         UCVS(I) = UTVS*XVS(I)
 1140 CONTINUE

      RR(1) = DEXP(31.5859536-40000.0/1.987/TKR)*R1F
      RR(2) = DEXP(3.00094014-20000.0/1.987/TKR)*R2F
      RR(3) = DEXP(53.4060443-60000.0/1.987/TKR)
      RR(4) = RR(3)*0.767488334D0

      IF (PPR(1).GT.0.0 .AND. PPR(3).GT.0.0) THEN
         R1F   = PPR(1)**1.1544
         R2F   = PPR(3)**0.3735
         RR(1) = RR(1)*R1F*R2F*PPR(4)
         RR(2) = RR(2)*R1F*R2F*PPR(5)
      ELSE
         RR(1) = 0.0
         RR(2) = 0.0
      ENDIF

      RR(3) = RR(3)*PPR(1)*PPR(5)
      RR(4) = RR(4)*PPR(1)*PPR(4)

      DO 1200 I = 1,4
         RR(I) = RR(I)*VVR
 1200 CONTINUE


C ---
C 18) TAXAS DE REAÇÃO POR COMPONENTE
C ---

      CRXR(1) = -RR(1)-RR(2)-RR(3)
      CRXR(3) = -RR(1)-RR(2)
      CRXR(4) = -RR(1)-1.5D0*RR(4)
      CRXR(5) = -RR(2)-RR(3)
      CRXR(6) =  RR(3)+RR(4)
      CRXR(7) =  RR(1)
      CRXR(8) =  RR(2)

      RH = RR(1)*HTR(1) + RR(2)*HTR(2)


C ---
C 19) CÁLCULO DE MASSAS MOLARES MÉDIAS DAS CORRENTES
C ---

      XMWS(1)  = 0.0
      XMWS(2)  = 0.0
      XMWS(6)  = 0.0
      XMWS(8)  = 0.0
      XMWS(9)  = 0.0
      XMWS(10) = 0.0

      DO 2010 I = 1,8
         XST(I,6)  = XVV(I)
         XST(I,8)  = XVR(I)
         XST(I,9)  = XVS(I)
         XST(I,10) = XVS(I)
         XST(I,11) = XLS(I)
         XST(I,13) = XLC(I)

         XMWS(1)  = XMWS(1)  + XST(I,1)  * XMW(I)
         XMWS(2)  = XMWS(2)  + XST(I,2)  * XMW(I)
         XMWS(6)  = XMWS(6)  + XST(I,6)  * XMW(I)
         XMWS(8)  = XMWS(8)  + XST(I,8)  * XMW(I)
         XMWS(9)  = XMWS(9)  + XST(I,9)  * XMW(I)
         XMWS(10) = XMWS(10) + XST(I,10) * XMW(I)
 2010 CONTINUE


C ---
C 20) ATRIBUIÇÃO DAS TEMPERATURAS DAS CORRENTES
C ---

      TST(6)  = TCV
      TST(8)  = TCR
      TST(9)  = TCS
      TST(10) = TCS
      TST(11) = TCS
      TST(13) = TCC


C ---
C 21) CÁLCULO DE ENTALPIAS DAS CORRENTES
C ---

      CALL TESUB1(XST(1,1),  TST(1),  HST(1),  1)
      CALL TESUB1(XST(1,2),  TST(2),  HST(2),  1)
      CALL TESUB1(XST(1,3),  TST(3),  HST(3),  1)
      CALL TESUB1(XST(1,4),  TST(4),  HST(4),  1)
      CALL TESUB1(XST(1,6),  TST(6),  HST(6),  1)
      CALL TESUB1(XST(1,8),  TST(8),  HST(8),  1)
      CALL TESUB1(XST(1,9),  TST(9),  HST(9),  1)

      HST(10) = HST(9)

      CALL TESUB1(XST(1,11), TST(11), HST(11), 0)
      CALL TESUB1(XST(1,13), TST(13), HST(13), 0)


C ---
C 22) CÁLCULO DAS VAZÕES (VÁLVULAS, PRESSÕES, COMPRESSORES)
C ---

      FTM(1)  = VPOS(1) * VRNG(1) / 100.0
      FTM(2)  = VPOS(2) * VRNG(2) / 100.0
      FTM(3)  = VPOS(3) * (1.D0-IDV(6)) * VRNG(3) / 100.0

      FTM(4)  = VPOS(4)
     .          * (1.D0 - IDV(7)*0.2D0)
     .          * VRNG(4) / 100.0
     .          + 1.D-10

      FTM(11) = VPOS(7) * VRNG(7) / 100.0
      FTM(13) = VPOS(8) * VRNG(8) / 100.0

      UAC     = VPOS(9) * VRNG(9)
     .          * (1.D0 + TESUB8(9,TIME)) / 100.0

      FWR     = VPOS(10) * VRNG(10) / 100.0
      FWS     = VPOS(11) * VRNG(11) / 100.0
      AGSP    = (VPOS(12) + 150.0) / 100.0


C ---
C 23) FLUXOS DEPENDENTES DE DIFERENÇA DE PRESSÃO
C ---

      DLP = PTV - PTR
      IF (DLP .LT. 0.0) DLP = 0.0
      FLMS = 1937.6D0 * DSQRT(DLP)
      FTM(6) = FLMS / XMWS(6)

      DLP = PTR - PTS
      IF (DLP .LT. 0.0) DLP = 0.0
      FLMS = 4574.21D0 * DSQRT(DLP)
     .       * (1.D0 - 0.25D0 * TESUB8(12,TIME))
      FTM(8) = FLMS / XMWS(8)

      DLP = PTS - 760.0
      IF (DLP .LT. 0.0) DLP = 0.0
      FLMS = VPOS(6) * 0.151169D0 * DSQRT(DLP)
      FTM(10) = FLMS / XMWS(10)


C ---
C 24) COMPRESSOR, CALOR E AJUSTES DE ENERGIA
C ---

      PR = PTV / PTS
      IF (PR .LT. 1.0) PR = 1.0
      IF (PR .GT. CPPRMX) PR = CPPRMX

      FLCOEF = CPFLMX / 1.197D0
      FLMS   = CPFLMX + FLCOEF * (1.0 - PR**3)

      CPDH = FLMS * (TCS + 273.15D0)
     .       * 1.8D-6 * 1.9872D0
     .       * (PTV - PTS) / (XMWS(9) * PTS)

      DLP = PTV - PTS
      IF (DLP .LT. 0.0) DLP = 0.0
      FLMS = FLMS - VPOS(5) * 53.349D0 * DSQRT(DLP)
      IF (FLMS .LT. 1.D-3) FLMS = 1.D-3

      FTM(9) = FLMS / XMWS(9)
      HST(9) = HST(9) + CPDH / FTM(9)


C ---
C 25) CONSTRUÇÃO DA MATRIZ DE FLUXOS POR COMPONENTE (vazão mássica de cada espécie em cada corrente)
C ---

      DO 5020 I = 1,8
         FCM(I,1)  = XST(I,1)  * FTM(1)
         FCM(I,2)  = XST(I,2)  * FTM(2)
         FCM(I,3)  = XST(I,3)  * FTM(3)
         FCM(I,4)  = XST(I,4)  * FTM(4)
         FCM(I,6)  = XST(I,6)  * FTM(6)
         FCM(I,8)  = XST(I,8)  * FTM(8)
         FCM(I,9)  = XST(I,9)  * FTM(9)
         FCM(I,10) = XST(I,10) * FTM(10)
         FCM(I,11) = XST(I,11) * FTM(11)
         FCM(I,13) = XST(I,13) * FTM(13)
 5020 CONTINUE


C ---
C 26) MODELO DO SEPARADOR / FLASH (frações de split dependentes de temperatura e vazões)
C ---

      IF (FTM(11) .GT. 0.1) THEN

         IF (TCC .GT. 170.) THEN
            TMPFAC = TCC - 120.262
         ELSEIF (TCC .LT. 5.292) THEN
            TMPFAC = 0.1
         ELSE
            TMPFAC = 363.744 / (177. - TCC) - 2.22579488
         ENDIF

         VOVRL = FTM(4) / FTM(11) * TMPFAC

         SFR(4) = 8.5010 * VOVRL / (1.0 + 8.5010 * VOVRL)
         SFR(5) = 11.402 * VOVRL / (1.0 + 11.402 * VOVRL)
         SFR(6) = 11.795 * VOVRL / (1.0 + 11.795 * VOVRL)
         SFR(7) = 0.0480 * VOVRL / (1.0 + 0.0480 * VOVRL)
         SFR(8) = 0.0242 * VOVRL / (1.0 + 0.0242 * VOVRL)

      ELSE

         SFR(4) = 0.9999
         SFR(5) = 0.999
         SFR(6) = 0.999
         SFR(7) = 0.99
         SFR(8) = 0.98

      END IF


C ---
C 27) CÁLCULO DAS CORRENTES DE ENTRADA NO SEPARADOR
C ---

      DO 6010 I = 1,8
         FIN(I) = 0.0
         FIN(I) = FIN(I) + FCM(I,4)
         FIN(I) = FIN(I) + FCM(I,11)
 6010 CONTINUE


C ---
C 28) SPLIT DE FASES (LÍQUIDO / VAPOR)
C ---

      FTM(5)  = 0.0
      FTM(12) = 0.0

      DO 6020 I = 1,8
         FCM(I,5)  = SFR(I) * FIN(I)
         FCM(I,12) = FIN(I) - FCM(I,5)
         FTM(5)    = FTM(5)  + FCM(I,5)
         FTM(12)   = FTM(12) + FCM(I,12)
 6020 CONTINUE


C ---
C 29) COMPOSIÇÃO DAS CORRENTES RESULTANTES
C ---

      DO 6030 I = 1,8
         XST(I,5)  = FCM(I,5)  / FTM(5)
         XST(I,12) = FCM(I,12) / FTM(12)
 6030 CONTINUE


C ---
C 30) ENTALPIAS DAS CORRENTES DO SEPARADOR
C ---

      TST(5)  = TCC
      TST(12) = TCC

      CALL TESUB1(XST(1,5),  TST(5),  HST(5),  1)
      CALL TESUB1(XST(1,12), TST(12), HST(12), 0)

C ---
C 31) BYPASS / RECICLO INTERNO
C ---

      FTM(7) = FTM(6)
      HST(7) = HST(6)
      TST(7) = TST(6)

      DO 6130 I = 1,8
         XST(I,7) = XST(I,6)
         FCM(I,7) = FCM(I,6)
 6130 CONTINUE

C ---
C 32) MODELO DE TROCA TÉRMICA NO REATOR
C ---

      IF (VLR/7.8 .GT. 50.0) THEN
         UARLEV = 1.0
      ELSEIF (VLR/7.8 .LT. 10.0) THEN
         UARLEV = 0.0
      ELSE
         UARLEV = 0.025 * VLR/7.8 - 0.25
      ENDIF

      UAR = UARLEV
     .      * (-0.5*AGSP**2 + 2.75*AGSP - 2.5)
     .      * 855490.D-6

      QUR = UAR * (TWR - TCR)
     .      * (1.D0 - 0.35D0 * TESUB8(10,TIME))

C ---
C 33) TROCA TÉRMICA NO SEPARADOR
C ---

      UAS = 0.404655
     .      * (1.0 - 1.0/(1.0 + (FTM(8)/3528.73)**4))

      QUS = UAS * (TWS - TST(8))
     .      * (1.D0 - 0.25D0 * TESUB8(11,TIME))

C ---
C 34) RESFRIAMENTO CONDICIONAL
C ---

      QUC = 0.D0
      IF (TCC .LT. 100.) QUC = UAC * (100.0 - TCC)

C ---
C 35) CONSTRUÇÃO DAS VARIÁVEIS MEDIDAS (XMEAS)
C ---

      XMEAS(1)  = FTM(3)  * 0.359 / 35.3145
      XMEAS(2)  = FTM(1)  * XMWS(1) * 0.454
      XMEAS(3)  = FTM(2)  * XMWS(2) * 0.454
      XMEAS(4)  = FTM(4)  * 0.359 / 35.3145
      XMEAS(5)  = FTM(9)  * 0.359 / 35.3145
      XMEAS(6)  = FTM(6)  * 0.359 / 35.3145
      XMEAS(7)  = (PTR - 760.0)/760.0 * 101.325
      XMEAS(8)  = (VLR - 84.6)/666.7 * 100.0
      XMEAS(9)  = TCR
      XMEAS(10) = FTM(10) * 0.359 / 35.3145
      XMEAS(11) = TCS
      XMEAS(12) = (VLS - 27.5)/290.0 * 100.0
      XMEAS(13) = (PTS - 760.0)/760.0 * 101.325
      XMEAS(14) = FTM(11)/DLS/35.3145
      XMEAS(15) = (VLC - 78.25)/VTC * 100.0
      XMEAS(16) = (PTV - 760.0)/760.0 * 101.325
      XMEAS(17) = FTM(13)/DLC/35.3145
      XMEAS(18) = TCC
      XMEAS(19) = QUC * 1.04D3 * 0.454
      XMEAS(20) = CPDH * 0.29307D3
      XMEAS(21) = TWR
      XMEAS(22) = TWS

C ---
C 36) DETECÇÃO DE CONDIÇÕES INVÁLIDAS / FALHA
C ---

      ISD = 0

      IF (XMEAS(7) .GT. 3000.0) ISD = 1
      IF (VLR/35.3145 .GT. 24.0) ISD = 1
      IF (VLR/35.3145 .LT. 2.0)  ISD = 1
      IF (XMEAS(9) .GT. 175.0)   ISD = 1
      IF (VLS/35.3145 .GT. 12.0) ISD = 1
      IF (VLS/35.3145 .LT. 1.0)  ISD = 1
      IF (VLC/35.3145 .GT. 8.0)  ISD = 1
      IF (VLC/35.3145 .LT. 1.0)  ISD = 1

C ---
C 37) ADIÇÃO DE RUÍDO ÀS MEDIÇÕES
C ---

      IF (TIME .GT. 0.0 .AND. ISD .EQ. 0) THEN
         DO 6500 I = 1,22
            CALL TESUB6(XNS(I), XMNS)
            XMEAS(I) = XMEAS(I) + XMNS
 6500    CONTINUE
      ENDIF

C ---
C 38) COMPOSIÇÕES PARA PRODUTOS (AMOSTRAGEM LENTA)
C ---

      XCMP(23) = XST(1,7)  * 100.0
      XCMP(24) = XST(2,7)  * 100.0
      XCMP(25) = XST(3,7)  * 100.0
      XCMP(26) = XST(4,7)  * 100.0
      XCMP(27) = XST(5,7)  * 100.0
      XCMP(28) = XST(6,7)  * 100.0
      XCMP(29) = XST(1,10) * 100.0
      XCMP(30) = XST(2,10) * 100.0
      XCMP(31) = XST(3,10) * 100.0
      XCMP(32) = XST(4,10) * 100.0
      XCMP(33) = XST(5,10) * 100.0
      XCMP(34) = XST(6,10) * 100.0
      XCMP(35) = XST(7,10) * 100.0
      XCMP(36) = XST(8,10) * 100.0
      XCMP(37) = XST(4,13) * 100.0
      XCMP(38) = XST(5,13) * 100.0
      XCMP(39) = XST(6,13) * 100.0
      XCMP(40) = XST(7,13) * 100.0
      XCMP(41) = XST(8,13) * 100.0

C ---
C 39) LÓGICA DE AMOSTRAGEM DISCRETA (ANALISADORES)
C ---

      IF (TIME .EQ. 0.D0) THEN
         DO 7010 I = 23,41
            XDEL(I)  = XCMP(I)
            XMEAS(I) = XCMP(I)
 7010    CONTINUE
         TGAS  = 0.1
         TPROD = 0.25
      ENDIF

      IF (TIME .GE. TGAS) THEN
         DO 7020 I = 23,36
            XMEAS(I) = XDEL(I)
            CALL TESUB6(XNS(I), XMNS)
            XMEAS(I) = XMEAS(I) + XMNS
            XDEL(I)  = XCMP(I)
 7020    CONTINUE
         TGAS = TGAS + 0.1
      ENDIF

      IF (TIME .GE. TPROD) THEN
         DO 7030 I = 37,41
            XMEAS(I) = XDEL(I)
            CALL TESUB6(XNS(I), XMNS)
            XMEAS(I) = XMEAS(I) + XMNS
            XDEL(I)  = XCMP(I)
 7030    CONTINUE
         TPROD = TPROD + 0.25
      ENDIF

C ---
C 40) EQUAÇÕES DIFERENCIAIS (EDOs DO PROCESSO)
C ---

      DO 9010 I = 1,8
         YP(I)      = FCM(I,7) - FCM(I,8) + CRXR(I)
         YP(I+9)    = FCM(I,8) - FCM(I,9)
     .                - FCM(I,10) - FCM(I,11)
         YP(I+18)   = FCM(I,12) - FCM(I,13)
         YP(I+27)   = FCM(I,1) + FCM(I,2)
     .                + FCM(I,3) + FCM(I,5)
     .                + FCM(I,9) - FCM(I,6)
 9010 CONTINUE

      YP(9)  = HST(7)*FTM(7) - HST(8)*FTM(8)
     .         + RH + QUR

      YP(18) = HST(8)*FTM(8) - HST(9)*FTM(9)
     .         - HST(10)*FTM(10) - HST(11)*FTM(11)
     .         + QUS

      YP(27) = HST(4)*FTM(4) + HST(11)*FTM(11)
     .         - HST(5)*FTM(5) - HST(13)*FTM(13)
     .         + QUC

      YP(36) = HST(1)*FTM(1) + HST(2)*FTM(2)
     .         + HST(3)*FTM(3) + HST(5)*FTM(5)
     .         + HST(9)*FTM(9) - HST(6)*FTM(6)

C ---
C 41) BLOQUEIO DA DINÂMICA EM CASO DE FALHA
C ---

      IF (ISD .NE. 0) THEN
         DO 9030 I = 1,NN
            YP(I) = 0.0
 9030    CONTINUE
      ENDIF

      RETURN
      END


