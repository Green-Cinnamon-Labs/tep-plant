C ============================================================
C TESUB1 – Cálculo de entalpia da mistura
C ------------------------------------------------------------
C Entrada:
C   Z   -> fração molar dos 8 componentes
C   T   -> temperatura (°C)
C   ITY -> tipo de fase/modelo
C          0 = líquido
C          1 = vapor
C          2 = vapor com correção PV
C Saída:
C   H   -> entalpia total da mistura
C ============================================================

      SUBROUTINE TESUB1(Z,T,H,ITY)

C --- Constantes termodinâmicas
      DOUBLE PRECISION
     . AVP,BVP,CVP,
     . AH,BH,CH,
     . AG,BG,CG,
     . AV,
     . AD,BD,CD,
     . XMW

      COMMON /CONST/
     . AVP(8),BVP(8),CVP(8),
     . AH(8),BH(8),CH(8),
     . AG(8),BG(8),CG(8),
     . AV(8),
     . AD(8),BD(8),CD(8),
     . XMW(8)

C --- Variáveis locais
      DOUBLE PRECISION Z(8), T, H, HI, R
      INTEGER ITY, I

C ------------------------------------------------------------
C Caso líquido (ITY = 0)
C ------------------------------------------------------------
      IF (ITY .EQ. 0) THEN
         H = 0.0D0
         DO 100 I = 1, 8
            HI = T * ( AH(I)
     .               + BH(I)*T/2.D0
     .               + CH(I)*T**2/3.D0 )
            HI = 1.8D0 * HI
            H  = H + Z(I)*XMW(I)*HI
 100     CONTINUE

C ------------------------------------------------------------
C Caso vapor (ITY ≠ 0)
C ------------------------------------------------------------
      ELSE
         H = 0.0D0
         DO 200 I = 1, 8
            HI = T * ( AG(I)
     .               + BG(I)*T/2.D0
     .               + CG(I)*T**2/3.D0 )
            HI = 1.8D0 * HI + AV(I)
            H  = H + Z(I)*XMW(I)*HI
 200     CONTINUE
      END IF

C ------------------------------------------------------------
C Correção para gás ideal (ITY = 2)
C ------------------------------------------------------------
      IF (ITY .EQ. 2) THEN
         R = 3.57696D0 / 1.D6
         H = H - R*(T + 273.15D0)
      END IF

      RETURN
      END


C ============================================================
C TESUB2 – Cálculo inverso: temperatura a partir da entalpia
C ------------------------------------------------------------
C Resolve T tal que:
C     H(Z, T) = H_desejado
C Método: Newton-Raphson
C ============================================================

      SUBROUTINE TESUB2(Z,T,H,ITY)

      DOUBLE PRECISION
     . AVP,BVP,CVP,
     . AH,BH,CH,
     . AG,BG,CG,
     . AV,
     . AD,BD,CD,
     . XMW

      COMMON /CONST/
     . AVP(8),BVP(8),CVP(8),
     . AH(8),BH(8),CH(8),
     . AG(8),BG(8),CG(8),
     . AV(8),
     . AD(8),BD(8),CD(8),
     . XMW(8)

      DOUBLE PRECISION Z(8), T, H, TIN
      DOUBLE PRECISION HTEST, ERR, DH, DT
      INTEGER ITY, J

      TIN = T

      DO 250 J = 1, 100
         CALL TESUB1(Z, T, HTEST, ITY)
         ERR = HTEST - H
         CALL TESUB3(Z, T, DH, ITY)
         DT  = -ERR / DH
         T   = T + DT
 250     IF (DABS(DT) .LT. 1.D-12) GO TO 300

      T = TIN

 300  RETURN
      END

C ============================================================
C TESUB3 – Derivada da entalpia em relação à temperatura
C ------------------------------------------------------------
C Calcula:
C     dH/dT
C ============================================================

      SUBROUTINE TESUB3(Z,T,DH,ITY)

      DOUBLE PRECISION
     . AVP,BVP,CVP,
     . AH,BH,CH,
     . AG,BG,CG,
     . AV,
     . AD,BD,CD,
     . XMW

      COMMON /CONST/
     . AVP(8),BVP(8),CVP(8),
     . AH(8),BH(8),CH(8),
     . AG(8),BG(8),CG(8),
     . AV(8),
     . AD(8),BD(8),CD(8),
     . XMW(8)

      DOUBLE PRECISION Z(8), T, DH, DHI, R
      INTEGER ITY, I

C --- Líquido
      IF (ITY .EQ. 0) THEN
         DH = 0.0D0
         DO 100 I = 1, 8
            DHI = AH(I) + BH(I)*T + CH(I)*T**2
            DHI = 1.8D0 * DHI
            DH  = DH + Z(I)*XMW(I)*DHI
 100     CONTINUE

C --- Vapor
      ELSE
         DH = 0.0D0
         DO 200 I = 1, 8
            DHI = AG(I) + BG(I)*T + CG(I)*T**2
            DHI = 1.8D0 * DHI
            DH  = DH + Z(I)*XMW(I)*DHI
 200     CONTINUE
      END IF

C --- Correção gás ideal
      IF (ITY .EQ. 2) THEN
         R  = 3.57696D0 / 1.D6
         DH = DH - R
      END IF

      RETURN
      END

C ============================================================
C TESUB4 – Cálculo de densidade da mistura
C ------------------------------------------------------------
C Usa correlação empírica:
C     ρ = 1 / Σ (xi * Mi / Vi(T))
C ============================================================

      SUBROUTINE TESUB4(X,T,R)

      DOUBLE PRECISION
     . AVP,BVP,CVP,
     . AH,BH,CH,
     . AG,BG,CG,
     . AV,
     . AD,BD,CD,
     . XMW

      COMMON /CONST/
     . AVP(8),BVP(8),CVP(8),
     . AH(8),BH(8),CH(8),
     . AG(8),BG(8),CG(8),
     . AV(8),
     . AD(8),BD(8),CD(8),
     . XMW(8)

      DOUBLE PRECISION X(8), T, R, V
      INTEGER I

      V = 0.0D0
      DO 10 I = 1, 8
         V = V + X(I)*XMW(I)
     .       /( AD(I) + (BD(I) + CD(I)*T)*T )
   10 CONTINUE

      R = 1.0D0 / V

      RETURN
      END

C ============================================================
C TESUB5 – Atualização polinomial de distúrbios
C ------------------------------------------------------------
C Gera polinômio cúbico contínuo no tempo
C ============================================================

      SUBROUTINE TESUB5(S,SP,ADIST,BDIST,CDIST,DDIST,
     .                  TLAST,TNEXT,
     .                  HSPAN,HZERO,
     .                  SSPAN,SZERO,SPSPAN,
     .                  IDVFLAG)

      DOUBLE PRECISION
     . S, SP, H, S1, S1P,
     . ADIST, BDIST, CDIST, DDIST,
     . TLAST, TNEXT,
     . HSPAN, HZERO,
     . SSPAN, SZERO, SPSPAN,
     . TESUB7

      INTEGER I, IDVFLAG

      I = -1
      H  = HSPAN*TESUB7(I) + HZERO
      S1 = SSPAN*TESUB7(I)*IDVFLAG + SZERO
      S1P = SPSPAN*TESUB7(I)*IDVFLAG

      ADIST = S
      BDIST = SP
      CDIST = (3.D0*(S1-S) - H*(S1P+2.D0*SP)) / H**2
      DDIST = (2.D0*(S-S1) + H*(S1P+SP)) / H**3

      TNEXT = TLAST + H

      RETURN
      END

C ============================================================
C TESUB6 – Geração de ruído branco normalizado
C ============================================================

      SUBROUTINE TESUB6(STD,X)

      DOUBLE PRECISION STD, X, TESUB7
      INTEGER I

      X = 0.D0
      DO 2 I = 1, 12
    2 X = X + TESUB7(I)

      X = (X - 6.D0) * STD

      RETURN
      END

C ============================================================
C TESUB7 – Gerador de números pseudo-aleatórios
C ============================================================

      DOUBLE PRECISION FUNCTION TESUB7(I)

      INTEGER I
      DOUBLE PRECISION G, DMOD
      COMMON /RANDSD/ G

      G = DMOD(G*9228907.D0, 4294967296.D0)

      IF (I .GE. 0) TESUB7 =  G / 4294967296.D0
      IF (I .LT. 0) TESUB7 =  2.D0*G/4294967296.D0 - 1.D0

      RETURN
      END
</file>

