	OPEN(UNIT=2120,FILE='~/TE_data_me10.dat',STATUS='new')
	OPEN(UNIT=2121,FILE='~/TE_data_me11.dat',STATUS='new')
C
C
C  Simulation Loop
C
        DO 1000 I = 1, NPTS
         IF (I.GE.SSPTS) THEN
                 IDV(12)=1
          ENDIF
	  TEST=MOD(I,3)
	  IF (TEST.EQ.0) THEN
		CALL CONTRL1
	  	CALL CONTRL2
	  	CALL CONTRL3
	  	CALL CONTRL4
	  	CALL CONTRL5
	  	CALL CONTRL6
	  	CALL CONTRL7
	  	CALL CONTRL8
	  	CALL CONTRL9
	  	CALL CONTRL10
	  	CALL CONTRL11
	  	CALL CONTRL16
	  	CALL CONTRL17
	  	CALL CONTRL18
	  ENDIF
          TEST1=MOD(I,360)
	  IF (TEST1.EQ.0) THEN
	  	CALL CONTRL13
	  	CALL CONTRL14
	  	CALL CONTRL15
	  	CALL CONTRL19
	  ENDIF
	  TEST1=MOD(I,900)
	  IF (TEST1.EQ.0) CALL CONTRL20
	  TEST3=MOD(I,5000)       
	  IF (TEST3.EQ.0) THEN
		PRINT *, 'Simulation time (in seconds) = ', I
	
	ENDIF
C
 	TEST4=MOD(I,180)	
	IF (TEST4.EQ.0) THEN
		CALL OUTPUT
      		WRITE(111,111) I
 111  		FORMAT(1X,I6)
     	ENDIF
